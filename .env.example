APP_ENV=local
DB_DSN=sqlite:data/app.sqlite
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_NAME="Demo administrator"
# Required on first boot: generate your own hash as described in README.md.
# Keep the hash single-quoted; never put a plaintext password here.
ADMIN_SEED_PASSWORD_HASH=''

# Optional absolute public base URL (no trailing slash) used for canonical
# links and Open Graph tags, e.g. APP_URL=https://habi.example.com.
# Leave blank to derive it from each request's scheme and host.
# APP_URL=
