{#-
  Habi shell layout, matching the reference UI exactly: 64px sticky header
  (multicolour mark + 26px wordmark, icon-only search, bag link with the
  server cart count that cart.js enhances into the accessible drawer),
  mobile menu as a native <dialog>, dark brown footer with inverse 34px
  wordmark, three columns and selvedge strip.
  Receives exactly: app_name (string), app_env (string), cart (CartService
  array), csrf_token (string). No catalog queries.
  Anchors: #main-content, #craft, #materials. Navigation works without
  JavaScript (footer links); the mobile dialog and material tabs enhance.
  storefront.js is loaded on every page; child templates overriding the
  scripts block must keep it via {{ parent() }}.
  The <head> renders per-page SEO from the title, description, robots,
  og_type and head blocks plus the site_url and canonical_path globals:
  meta description, canonical link, Open Graph, Twitter card, theme-color.
-#}
{% import "macros/icons.twig" as icons %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set page_title %}{% block title %}{{ app_name }} — woven bags, woven with care{% endblock %}{% endset %}
  <title>{{ page_title|trim }}</title>
  {% block robots %}{% endblock %}
  {% set page_description %}{% block description %}Explore Habi's fictional handwoven-style bags, inspect their 3D details, and try a clearly simulated guest checkout. An educational demo: nothing is charged or shipped.{% endblock %}{% endset %}
  <meta name="description" content="{{ page_description|trim }}">
  <meta name="theme-color" content="#f8f4ea">
  <link rel="canonical" href="{{ site_url ~ canonical_path }}">
  <meta property="og:site_name" content="{{ app_name }}">
  <meta property="og:type" content="{% block og_type %}website{% endblock %}">
  <meta property="og:title" content="{{ page_title|trim }}">
  <meta property="og:description" content="{{ page_description|trim }}">
  <meta property="og:url" content="{{ site_url ~ canonical_path }}">
  <meta property="og:image" content="{{ site_url }}/assets/img/og-habi.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ app_name }} — woven bags, woven with care">
  <meta name="twitter:card" content="summary_large_image">
  {% block head %}{% endblock %}
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg">
</head>
<body class="@container bg-page">
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="sticky top-0 z-30 border-b border-line bg-page/95 backdrop-blur-sm">
    <div class="mx-auto flex h-16 max-w-[1280px] items-center gap-2 px-4 @3xl:px-8">
      <button type="button" aria-label="Open menu" title="Open menu" aria-expanded="false"
              aria-controls="mobile-menu" data-menu-open hidden
              class="icon-btn relative -ml-2 @3xl:hidden">
        {{ icons.icon('menu') }}
      </button>
      <a href="/" class="touch-target flex items-center gap-2 rounded-sm py-1">
        <img src="/assets/img/reference/brand-mark.svg" width="26" height="26" alt="">
        <span class="relative inline-flex items-baseline font-display font-bold leading-none" role="img" aria-label="{{ app_name }}"
              style="font-size: 26px; color: var(--color-text-primary); letter-spacing: -0.035em; font-variation-settings: 'opsz' 96;">
          <span aria-hidden="true">hab</span>
          <span aria-hidden="true" class="relative">ı<img src="/assets/img/reference/wordmark-tittle.svg" alt=""
               class="absolute left-1/2 -translate-x-1/2 max-w-none" style="width: .2em; height: .2em; top: -.02em;"></span>
        </span>
      </a>
      <nav aria-label="Main" class="ml-8 hidden @3xl:block">
        <ul class="flex gap-1">
          <li>
            <a href="/" class="relative flex h-11 items-center px-3 text-[15px] font-medium {% if active_nav|default('') == 'discover' %}text-ink{% else %}text-ink-2 hover:text-ink{% endif %}"{% if active_nav|default('') == 'discover' %} aria-current="page"{% endif %}>Discover{% if active_nav|default('') == 'discover' %}<span class="absolute inset-x-3 bottom-1.5 h-[3px] bg-action" aria-hidden="true"></span>{% endif %}</a>
          </li>
          <li>
            <a href="/products" class="relative flex h-11 items-center px-3 text-[15px] font-medium {% if active_nav|default('') == 'collection' %}text-ink{% else %}text-ink-2 hover:text-ink{% endif %}"{% if active_nav|default('') == 'collection' %} aria-current="page"{% endif %}>Collection{% if active_nav|default('') == 'collection' %}<span class="absolute inset-x-3 bottom-1.5 h-[3px] bg-action" aria-hidden="true"></span>{% endif %}</a>
          </li>
          <li>
            <a href="/#materials" class="relative flex h-11 items-center px-3 text-[15px] font-medium text-ink-2 hover:text-ink">Materials</a>
          </li>
        </ul>
      </nav>
      <div class="ml-auto flex items-center gap-1">
        <a href="/products#collection-search" aria-label="Search the collection" title="Search the collection" class="icon-btn relative">
          {{ icons.icon('search') }}
        </a>
        <a href="/cart" data-cart-bag class="icon-btn relative"
           aria-label="Bag{% if cart.count|default(0) > 0 %}, {{ cart.count }} {{ cart.count == 1 ? 'item' : 'items' }}{% else %}, empty{% endif %}"
           title="Bag{% if cart.count|default(0) > 0 %}, {{ cart.count }} {{ cart.count == 1 ? 'item' : 'items' }}{% endif %}">
          {{ icons.icon('bag') }}
          <span data-cart-count class="absolute top-1 right-1 grid h-[18px] min-w-[18px] place-items-center rounded-sm bg-action px-1 text-[11px] font-bold text-on-action"{% if cart.count|default(0) == 0 %} hidden{% endif %}>{{ cart.count|default(0) }}</span>
        </a>
      </div>
    </div>
  </header>

  <dialog id="mobile-menu" aria-labelledby="mobile-menu-title"
          class="anim-fade flex w-full max-w-[400px] flex-col bg-surface shadow-overlay">
    <div class="flex items-center justify-between border-b border-line py-3 pr-3 pl-5">
      <h2 id="mobile-menu-title" class="text-h3 font-semibold">Menu</h2>
      <button type="button" aria-label="Close" title="Close" data-menu-close class="icon-btn relative">
        {{ icons.icon('close') }}
      </button>
    </div>
    <div class="flex-1 overflow-auto">
      <nav aria-label="Mobile">
        <ul class="p-2">
          <li><a href="/" class="flex h-14 w-full items-center justify-between rounded-control px-3 text-left font-display text-h3 font-semibold hover:bg-inset">Discover{{ icons.icon('chevron-right') }}</a></li>
          <li><a href="/products" class="flex h-14 w-full items-center justify-between rounded-control px-3 text-left font-display text-h3 font-semibold hover:bg-inset">Collection{{ icons.icon('chevron-right') }}</a></li>
          <li><a href="/#materials" class="flex h-14 w-full items-center justify-between rounded-control px-3 text-left font-display text-h3 font-semibold hover:bg-inset">Materials{{ icons.icon('chevron-right') }}</a></li>
          <li class="mt-2 border-t border-line pt-2">
            <a href="/cart" data-cart-bag class="flex h-12 w-full items-center gap-3 rounded-control px-3 text-left font-medium hover:bg-inset">
              {{ icons.icon('bag') }} Your bag
              {% if cart.count|default(0) > 0 %}<span class="sr-only">, {{ cart.count }} {{ cart.count == 1 ? 'item' : 'items' }}</span>{% endif %}
            </a>
          </li>
        </ul>
        <div class="mx-5 mt-6 h-24 overflow-hidden rounded-panel" aria-hidden="true">
          <img src="/assets/img/reference/hero-band.svg" alt="" class="block h-full w-full">
        </div>
      </nav>
    </div>
  </dialog>

  <main id="main-content" class="anim-fade" tabindex="-1">
    {% block content %}{% endblock %}
  </main>

  <footer class="bg-brown-900 text-inverse">
    <div class="h-2.5" aria-hidden="true">
      <img src="/assets/img/reference/footer-selvedge.svg" alt="" class="block h-full w-full">
    </div>
    <div class="mx-auto grid max-w-[1280px] gap-8 px-4 py-12 @3xl:grid-cols-[1.3fr_1fr_1fr] @3xl:px-8">
      <div>
        <span class="relative inline-flex items-baseline font-display font-bold leading-none" role="img" aria-label="{{ app_name }}"
              style="font-size: 34px; color: var(--color-text-inverse); letter-spacing: -0.035em; font-variation-settings: 'opsz' 96;">
          <span aria-hidden="true">hab</span>
          <span aria-hidden="true" class="relative">ı<img src="/assets/img/reference/wordmark-tittle.svg" alt=""
               class="absolute left-1/2 -translate-x-1/2 max-w-none" style="width: .2em; height: .2em; top: -.02em;"></span>
        </span>
        <p class="mt-3 max-w-xs text-small text-inverse/75">
          Contemporary Filipino craft, explored one weave at a time.
        </p>
      </div>
      <nav aria-label="Footer">
        <p class="text-caption font-semibold tracking-wider text-inverse/60 uppercase">Explore</p>
        <ul class="mt-2 space-y-0.5 text-small">
          <li><a href="/#craft" class="touch-link inline-block py-1.5 underline-offset-4 hover:underline">Discover the weave</a></li>
          <li><a href="/products" class="touch-link inline-block py-1.5 underline-offset-4 hover:underline">The collection</a></li>
          <li><a href="/cart" class="touch-link inline-block py-1.5 underline-offset-4 hover:underline">Your bag</a></li>
        </ul>
      </nav>
      <div>
        <p class="text-caption font-semibold tracking-wider text-inverse/60 uppercase">About this demo</p>
        <div class="mt-3">
          <p class="flex items-start gap-2 text-caption text-inverse/85">
            {{ icons.icon('info', 16, 'mt-0.5 flex-none text-yellow-400') }}
            <span>
              <strong class="font-semibold text-inverse">Educational demo.</strong> Habi is a fictional brand. Products, prices, orders and material labels are illustrative; nothing is sold, shipped or charged, and no maker or origin is claimed.
            </span>
          </p>
        </div>
      </div>
    </div>
  </footer>

  {% include 'storefront/_cart-drawer.twig' %}

  {% block scripts %}
  <script src="/assets/js/storefront.js" defer></script>
  <script src="/assets/js/cart.js" defer></script>
  {% endblock %}
</body>
</html>
