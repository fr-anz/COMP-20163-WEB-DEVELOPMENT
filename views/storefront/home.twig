{#-
  Habi discovery story (R1): five sequential scenes inside one .story
  wrapper that end at the catalog.
  1. Opening: dark full-height stage, strands draw behind the headline.
  2. The weave: a sticky stage (.story-weave) builds one loom diagram in
     three steps; storefront.js sets data-step from scroll progress.
  3. Materials: four alternating scenes, each linking to a real product.
  4. The bag: the first three featured products.
  5. Finale: dark call to the collection, continuing into the footer.
  Continuity (motion only): the wrapper's background/text colour follows the
  data-tone of the scene at mid-viewport, and one yellow thread
  (.story-thread) runs from the Scroll cue through the [data-thread]
  anchors — behind the loom as its lead warp, between each material's
  swatch and text, between the bags — and ends in the finale pattern. It
  draws as you scroll.
  Motion is progressive: without JavaScript, or with reduced motion, every
  step and scene renders in its final state with its own background.
  Receives: featured_products, materials_seen (material id => products),
  total, plus the shared shell context.
-#}
{% extends "layouts/base.twig" %}
{% import "macros/icons.twig" as icons %}
{% macro money(centavos) %}{% set cent = centavos % 100 %}&#8369;{{ (centavos / 100)|number_format(cent == 0 ? 0 : 2, '.', ',') }}{% endmacro %}
{% import _self as fmt %}
{% set active_nav = 'discover' %}

{% set materials = [
    { id: 'fiber', name: 'Natural fiber', line: 'Undyed strands in close rows. The tone shifts from strand to strand.' },
    { id: 'strip', name: 'Flat strip', line: 'Wide strips crossed one over one under, into a firm checker.' },
    { id: 'yarn', name: 'Yarn inlay', line: 'Coloured yarn worked into a fiber ground as a single band.' },
    { id: 'loom', name: 'Loom cloth', line: 'Warp stripes woven on a loom, then cut and stitched into panels.' },
] %}

{# Loom diagram geometry: 7 warp and 7 weft strands on a 64-unit pitch. The
   centre warp is the story thread's yellow, so the thread becomes its lead. #}
{% set loom_cells = 7 %}
{% set loom_lead = 3 %}
{% set loom_thread = '#E8B94D' %}
{% set loom_warp = ['#C9A877', '#B08F62'] %}
{% set loom_weft = ['#6D5A4B', '#8C7764'] %}
{% set loom_accent = { 0: '#426A94', 2: '#A8462C', 4: '#436D51' } %}

{% block title %}{{ app_name }} — handwoven bags{% endblock %}

{% block description %}Handwoven totes, satchels, slings and clutches. See how each Habi bag is made, strand by strand, then find yours in the collection.{% endblock %}

{% block content %}
  <div class="story" data-story data-tone="dark">
  <svg class="story-thread" aria-hidden="true" focusable="false" data-story-thread><path></path></svg>
  <section class="story-open" aria-labelledby="hero-h" data-tone="dark">
    <svg class="story-open__strands" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <path class="story-strand story-strand--yellow" pathLength="1" d="M-60 470 C 260 380, 560 560, 1260 410"></path>
      <path class="story-strand story-strand--blue" pathLength="1" d="M880 -60 C 820 220, 940 430, 860 760"></path>
      <path class="story-strand story-strand--green" pathLength="1" d="M-60 610 C 420 650, 820 540, 1260 620"></path>
    </svg>
    <div class="story-open__inner">
      <h1 id="hero-h" class="story-open__title">
        <span class="story-line"><span>Every bag begins</span></span>
        <span class="story-line"><span>as a single strand.</span></span>
      </h1>
    </div>
    <a href="#craft" class="story-open__cue" data-thread="start">
      <span>Scroll</span>
      {{ icons.icon('arrow-down', 20) }}
    </a>
  </section>

  <section id="craft" class="story-weave" aria-labelledby="weave-h" data-story-weave data-step="2" data-tone="page" data-thread="feed">
    <h2 id="weave-h" class="sr-only">How a bag is woven</h2>
    <div class="story-weave__stage">
      <ol class="story-weave__steps">
        <li class="story-weave__step" data-weave-step="0"><p>One strand.</p></li>
        <li class="story-weave__step" data-weave-step="1"><p>Over, then under.</p></li>
        <li class="story-weave__step" data-weave-step="2"><p>Row by row, a pattern.</p></li>
      </ol>
      <svg class="story-loom" viewBox="0 0 448 448" aria-hidden="true" focusable="false">
        <g class="story-loom__warp">
          {% for i in 0..loom_cells - 1 %}
          <rect x="{{ 12 + i * 64 }}" y="0" width="40" height="448" fill="{{ i == loom_lead ? loom_thread : loom_warp[i % 2] }}"{% if i == loom_lead %} data-lead{% endif %} style="--i: {{ i }}"></rect>
          {% endfor %}
        </g>
        <g class="story-loom__weft">
          {% for j in 0..loom_cells - 1 %}
          <rect x="0" y="{{ 12 + j * 64 }}" width="448" height="40" fill="{{ loom_weft[j % 2] }}" style="--i: {{ j }}"></rect>
          {% endfor %}
        </g>
        <g class="story-loom__over">
          {% for j in 0..loom_cells - 1 %}{% for i in 0..loom_cells - 1 %}{% if (i + j) % 2 == 0 %}
          <rect x="{{ 12 + i * 64 }}" y="{{ 12 + j * 64 }}" width="40" height="40" fill="{{ i == loom_lead ? loom_thread : loom_warp[i % 2] }}" style="--i: {{ j }}"></rect>
          {% endif %}{% endfor %}{% endfor %}
        </g>
        <g class="story-loom__pattern">
          {% for j in 0..loom_cells - 1 %}{% for i in 0..loom_cells - 1 %}{% set band = (i - j + loom_cells) % loom_cells %}{% if loom_accent[band] is defined %}
          <rect x="{{ 12 + i * 64 }}" y="{{ 12 + j * 64 }}" width="40" height="40" fill="{{ loom_accent[band] }}" style="--i: {{ i + j }}"></rect>
          {% endif %}{% endfor %}{% endfor %}
        </g>
      </svg>
    </div>
  </section>

  <section id="materials" class="story-materials" aria-labelledby="mat-h" data-tone="page">
    <h2 id="mat-h" class="story-heading" data-reveal data-thread="center">Four materials.</h2>
    {% for material in materials %}
    {% set seen = materials_seen[material.id][0] ?? null %}
    <article class="story-material" aria-labelledby="material-{{ material.id }}" data-thread="gap">
      <div class="story-material__media" data-reveal="wipe">
        <img src="/assets/img/reference/material-{{ material.id }}.svg" alt="" loading="lazy" decoding="async">
      </div>
      <div class="story-material__text" data-reveal>
        <h3 id="material-{{ material.id }}" class="story-material__name">{{ material.name }}</h3>
        <p class="story-material__line">{{ material.line }}</p>
        {% if seen %}
        <a href="/product/{{ seen.slug }}" class="story-link">{{ seen.name }} {{ icons.icon('arrow-right', 18) }}</a>
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </section>

  {% if featured_products|length > 0 %}
  {% set featured = featured_products[0] %}
  <section class="story-bag" aria-labelledby="bag-h" data-tone="inset">
    <h2 id="bag-h" class="story-heading" data-reveal data-thread="center">Then, a bag.</h2>
    <a href="/product/{{ featured.slug }}" class="story-bag__lead" data-thread="gap">
      <span class="story-bag__frame" data-reveal="wipe">
        <img src="{{ featured.image_path }}" alt="" width="480" height="600" loading="lazy" decoding="async">
      </span>
      <span class="story-bag__caption" data-reveal>
        <span class="story-bag__name">{{ featured.name }}</span>
        <span class="story-bag__price"><span class="sr-only">Price: </span>{{ fmt.money(featured.price_centavos) }}</span>
        <span class="btn btn--primary btn--lg">View bag {{ icons.icon('arrow-right', 20) }}</span>
      </span>
    </a>
    {% if featured_products|length > 1 %}
    <ul class="story-bag__more" data-thread="gap">
      {% for product in featured_products|slice(1, 2) %}
      <li data-reveal>
        <a href="/product/{{ product.slug }}" class="story-bag__card">
          <span class="story-bag__frame story-bag__frame--small">
            <img src="{{ product.image_path }}" alt="" width="480" height="600" loading="lazy" decoding="async">
          </span>
          <span class="story-bag__card-name">{{ product.name }}</span>
          <span class="story-bag__card-price"><span class="sr-only">Price: </span>{{ fmt.money(product.price_centavos) }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>
  {% endif %}

  <section class="story-finale" aria-labelledby="cta-h" data-tone="dark" data-thread="end">
    <img class="story-finale__pattern" src="/assets/img/reference/cta-pattern.svg" alt="" aria-hidden="true">
    <div class="story-finale__inner" data-reveal>
      <h2 id="cta-h" class="story-finale__title">{{ total }} bags.<br>Find yours.</h2>
      <a href="/products" class="btn btn--lg story-finale__action">Shop the collection {{ icons.icon('arrow-right', 20) }}</a>
    </div>
  </section>
  </div>
{% endblock %}
