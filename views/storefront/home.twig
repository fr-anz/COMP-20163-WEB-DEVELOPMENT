{% extends "layouts/base.twig" %}

{% block title %}{{ app_name }} — the weave comes first{% endblock %}

{% block content %}
  {% import "macros/icons.twig" as icons %}
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell">
      <p class="hero__kicker">A craft-first study in woven bags</p>
      <h1 class="hero__title" id="hero-title">The weave comes first.</h1>
      <p class="hero__lede">
        Habi means <em>weave</em> in Filipino. It is also the idea of this shop:
        bags built from interlaced fiber, honest structure, and color used
        sparingly. Look closely before you look to buy &mdash; the craft leads,
        the shopping follows.
      </p>
      <p class="hero__actions">
        <a class="btn btn--primary" href="#foundation">
          Discover the weave
          {{ icons.icon('arrow-down') }}
        </a>
      </p>
      <p class="hero__note">
        This is the foundation of the site. The full collection and checkout
        arrive in later milestones &mdash; nothing is for sale yet.
      </p>
    </div>
  </section>

  <section class="foundation" id="foundation" aria-labelledby="foundation-title">
    <div class="shell">
      <h2 class="foundation__title" id="foundation-title">The foundation, honestly laid</h2>
      <p class="foundation__lede">
        What you are looking at right now is the whole of milestone zero:
        the accessible page shell, the type and color system, and the licensed
        fonts that will carry every page after this one.
      </p>

      <div class="foundation__grid">
        <div class="foundation__panel">
          <h3>Colors of the loom</h3>
          <p>Warm cream and fiber tones carry the page; rust, mustard, moss,
             and river blue appear only as accents.</p>
          <ul class="swatches">
            <li class="swatch"><span class="swatch__chip swatch__chip--cream" aria-hidden="true"></span> Cream</li>
            <li class="swatch"><span class="swatch__chip swatch__chip--rust" aria-hidden="true"></span> Rust</li>
            <li class="swatch"><span class="swatch__chip swatch__chip--mustard" aria-hidden="true"></span> Mustard</li>
            <li class="swatch"><span class="swatch__chip swatch__chip--moss" aria-hidden="true"></span> Moss</li>
            <li class="swatch"><span class="swatch__chip swatch__chip--river" aria-hidden="true"></span> River</li>
          </ul>
        </div>

        <div class="foundation__panel">
          <h3>Lettering</h3>
          <p class="type-specimen" lang="en">Ag</p>
          <p>Headings are set in Bricolage Grotesque; everything you read is
             DM Sans. Both are open-licensed and served from this site.</p>
        </div>

        <div class="foundation__panel">
          <h3>Still on the loom</h3>
          <ul class="loom-list">
            <li>Browsing the full collection of bags</li>
            <li>Product pages with a close-up 3D view</li>
            <li>A demo cart and simulated checkout</li>
          </ul>
          <p>Each of these is described, not linked &mdash; the pages do not
             exist yet, and we do not pretend otherwise.</p>
        </div>
      </div>

      <p class="foundation__back">
        <a class="link-quiet" href="#main-content">
          Back to the top
          {{ icons.icon('arrow-right') }}
        </a>
      </p>
    </div>
  </section>
{% endblock %}
