{#-
  Cart empty state, shared by the /cart page and the cart drawer. Receives
  via context: nothing required. Published empty-state composition with the
  truthful session-only promise (R28: session lifetime, no saved cart).
-#}
{% import "macros/icons.twig" as icons %}
<div class="flex flex-col items-center px-6 py-10 text-center">
  <div class="relative mb-4 grid h-16 w-16 place-items-center rounded-panel bg-inset text-ink-2">
    {{ icons.icon('bag', 28) }}
    <span class="absolute -right-1 -bottom-1 h-3 w-3 bg-yellow-400" aria-hidden="true"></span>
  </div>
  <p class="font-display text-h3 font-semibold">Your bag is empty</p>
  <p class="mt-1 max-w-sm text-small text-ink-2">Bags you add will wait here.</p>
  <div class="mt-5">
    <a href="/products" class="btn btn--primary btn--sm"><span>Explore the collection</span></a>
  </div>
  <p class="mt-4 max-w-sm text-caption text-ink-2">Your bag lives only in this demo session &mdash; it is not saved between visits.</p>
</div>
