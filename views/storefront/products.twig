{% extends "layouts/base.twig" %}
{% import "macros/icons.twig" as icons %}
{% set active_nav = 'collection' %}

{% set has_filters = q != '' or category != '' or fiber != '' or region != '' or sort != 'featured' or hide_sold_out %}

{% block title %}{{ t('catalog.title') }} — {{ app_name }}{% endblock %}

{% block description %}{{ t('catalog.description', {count: categories|length}) }}{% endblock %}

{% block content %}
  <div class="mx-auto max-w-[1280px] px-4 py-8 @3xl:px-8 @3xl:py-12">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-6">
      <div>
        <h1 class="font-display text-[30px] font-bold @3xl:text-h1">{{ t('catalog.title') }}</h1>
      </div>
    </div>

    {# JavaScript auto-submits on change and hides the submit button; without
       JS the button stays visible and the form submits natively. #}
    <form role="search" method="get" action="/products" data-filters
          class="mt-6">
      <div class="grid gap-4 @3xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)] @5xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)] @3xl:items-end">
        <div>
          <label for="collection-search" class="field-label">{{ t('catalog.search') }}</label>
          <div class="relative">
            {{ icons.icon('search', 20, 'pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-ink-2') }}
            <input placeholder="{{ t('catalog.search_placeholder') }}" id="collection-search" class="input pl-10" type="search"
                   name="q" value="{{ q }}">
          </div>
        </div>
        <div>
          <label for="filter-category" class="field-label">{{ t('catalog.category') }}</label>
          <select id="filter-category" class="input" name="category">
            <option value="">{{ t('catalog.all_categories') }}</option>
            {% for cat in categories %}
              <option value="{{ cat }}"{% if cat == category %} selected{% endif %}>{{ category_labels[cat]|default(cat) }}</option>
            {% endfor %}
          </select>
        </div>
        <div>
          <label for="filter-fiber" class="field-label">{{ t('catalog.material') }}</label>
          <select id="filter-fiber" class="input" name="fiber">
            <option value="">{{ t('catalog.all_materials') }}</option>
            {% for key, label in fibers %}
              <option value="{{ key }}"{% if key == fiber %} selected{% endif %}>{{ t('fiber.' ~ key) }}</option>
            {% endfor %}
          </select>
        </div>
        <div>
          <label for="filter-region" class="field-label">{{ t('catalog.region') }}</label>
          <select id="filter-region" class="input" name="region">
            <option value="">{{ t('catalog.all_regions') }}</option>
            {% for name in regions %}
              <option value="{{ name }}"{% if name == region %} selected{% endif %}>{{ name }}</option>
            {% endfor %}
          </select>
        </div>
        <div>
          <label for="filter-sort" class="field-label">{{ t('catalog.sort') }}</label>
          <select id="filter-sort" class="input" name="sort">
            <option value="featured"{% if sort == 'featured' %} selected{% endif %}>{{ t('catalog.sort_featured') }}</option>
            <option value="newest"{% if sort == 'newest' %} selected{% endif %}>{{ t('catalog.sort_newest') }}</option>
            <option value="price_asc"{% if sort == 'price_asc' %} selected{% endif %}>{{ t('catalog.sort_price_asc') }}</option>
            <option value="price_desc"{% if sort == 'price_desc' %} selected{% endif %}>{{ t('catalog.sort_price_desc') }}</option>
          </select>
        </div>
        <button type="submit" data-filter-submit class="btn btn--secondary">{{ t('catalog.apply') }}</button>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <p class="text-small text-ink-2" role="status" aria-live="polite">{{ tn('catalog.count', total) }}</p>
        <label class="flex min-h-11 cursor-pointer items-center gap-2.5 text-small font-medium">
          <input class="check" type="checkbox" name="hide_sold_out" value="1"{% if hide_sold_out %} checked{% endif %}>{{ t('catalog.hide_sold_out') }}</label>
      </div>
    </form>

    {% if products|length > 0 %}
      <div class="mt-4">
        <h2 class="sr-only">{{ t('catalog.bags_heading') }}</h2>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-8 @3xl:grid-cols-3 @5xl:grid-cols-4 @5xl:gap-x-6">
          {% for product in products %}
            {% include 'storefront/_product-card.twig' with { product: product, csrf_token: csrf_token, eager: loop.index <= 4 } only %}
          {% endfor %}
        </ul>
      </div>
    {% elseif has_filters %}
      <div class="mt-4">
        <div class="rounded-panel border border-line bg-surface p-6">
          <h2 class="font-display text-h3 font-semibold">{{ t('catalog.no_match_title') }}</h2>
          <p class="mt-1 text-small text-ink-2">{{ t('catalog.no_match_body') }}</p>
          <p class="mt-3"><a class="link touch-link" href="/products">{{ t('catalog.clear_filters') }}</a></p>
        </div>
      </div>
    {% else %}
      <div class="mt-4">
        <div class="rounded-panel border border-line bg-surface p-6">
          <h2 class="font-display text-h3 font-semibold">{{ t('catalog.empty_title') }}</h2>
          <p class="mt-1 text-small text-ink-2">{{ t('catalog.empty_body') }}</p>
          <p class="mt-3"><a class="link touch-link" href="/">{{ t('catalog.back_home') }}</a></p>
        </div>
      </div>
    {% endif %}

    {% if pages > 1 %}
      <div class="mt-10 flex justify-center border-t border-line pt-6">
        <nav aria-label="{{ t('catalog.pagination') }}" class="flex items-center gap-1">
          {% if previous_url %}
            <a href="{{ previous_url }}" rel="prev" aria-label="{{ t('catalog.previous_page') }}" title="{{ t('catalog.previous_page') }}" class="icon-btn relative">
              {{ icons.icon('chevron-left') }}
            </a>
          {% else %}
            <span aria-disabled="true" class="icon-btn relative">
              {{ icons.icon('chevron-left') }}
            </span>
          {% endif %}
          {% for number in 1..pages %}
            {% if number == page %}
              <span aria-current="page" aria-label="{{ t('catalog.page', {number: number}) }}" class="grid h-11 w-11 place-items-center rounded-control text-[15px] font-semibold tabular-nums bg-ink text-inverse">{{ number }}</span>
            {% else %}
              <a href="{{ page_urls[number] }}" aria-label="{{ t('catalog.page', {number: number}) }}" class="grid h-11 w-11 place-items-center rounded-control text-[15px] font-semibold tabular-nums hover:bg-inset">{{ number }}</a>
            {% endif %}
          {% endfor %}
          {% if next_url %}
            <a href="{{ next_url }}" rel="next" aria-label="{{ t('catalog.next_page') }}" title="{{ t('catalog.next_page') }}" class="icon-btn relative">
              {{ icons.icon('chevron-right') }}
            </a>
          {% else %}
            <span aria-disabled="true" class="icon-btn relative">
              {{ icons.icon('chevron-right') }}
            </span>
          {% endif %}
        </nav>
      </div>
    {% endif %}
  </div>
{% endblock %}
