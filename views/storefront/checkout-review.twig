{#-
  Habi checkout step 3 — review (/checkout/review, POST /checkout/place),
  matching the published Checkout example's review step 1:1: "Ship to",
  "Payment" and "Delivery" cards with Edit links back to earlier steps, the
  verbatim simulated-payment banner, and the Place order button carrying the
  session-issued idempotency key. Place posts natively (works without
  JavaScript); checkout.js adds a spinner + polite status while the order
  commits. Stock changes after payment are rejected server-side and route
  back to the bag with an explanatory notice; nothing is charged for real.
  Receives exactly: app_name, app_env, cart, csrf_token, shipping (array),
  regions (key => label), shipping_fee_centavos (int), total_centavos (int),
  payment (result/last4/brand), idempotency_key, errors, message, step.
-#}
{% extends "layouts/base.twig" %}
{% import "macros/icons.twig" as icons %}
{% from 'storefront/_checkout-summary.twig' import disclosure as summary_disclosure, aside as summary_aside %}
{% set active_nav = '' %}
{% set region_label = regions[shipping.region]|default(shipping.region|default('')) %}
{% set total_cent = total_centavos % 100 %}

{% block title %}Checkout · Review — {{ app_name }}{% endblock %}

{% block description %}Habi checkout, step 3 of 4: review the order before placing it. Educational demo — a clearly simulated order; nothing is charged or shipped.{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block content %}
  <div class="mx-auto max-w-[1180px] px-4 py-6 @3xl:px-8 @3xl:py-10">
    <div class="flex items-center justify-between gap-4">
      <a href="/checkout/payment" class="btn btn--tertiary btn--sm">
        {{ icons.icon('arrow-left', 18) }}
        <span>Back to Payment</span>
      </a>
      <span class="flex items-center gap-1.5 text-caption text-ink-2">
        {{ icons.icon('lock', 16) }} Demo checkout
      </span>
    </div>

    {% include 'storefront/_checkout-stepper.twig' with { step: 3 } only %}

    {{ summary_disclosure(cart, 3, region_label, shipping_fee_centavos, total_centavos) }}

    <div class="mt-6 grid gap-10 @4xl:grid-cols-[minmax(0,1fr)_380px]">
      <div class="max-w-[640px]">
        <div>
          <h1 tabindex="-1" class="mb-6 font-display text-h2 font-semibold focus:outline-none">Review your order</h1>

          {% if message %}
            <div class="mb-6 flex gap-3 rounded-control border px-4 py-3 bg-error-bg text-error border-error/30" role="alert">
              {{ icons.icon('alert', 20, 'mt-0.5 flex-none') }}
              <div class="min-w-0 flex-1">
                <p class="text-[15px] font-semibold">{{ message }}</p>
              </div>
            </div>
          {% endif %}

          <div class="divide-y divide-line rounded-panel border border-line bg-surface">
            <div class="flex items-start justify-between gap-4 p-4">
              <div>
                <p class="text-small font-semibold">Ship to</p>
                {% set ship_lines = [
                  shipping.name|default(''),
                  shipping.address1|default('') ~ (shipping.address2|default('') ? ', ' ~ shipping.address2 : ''),
                  shipping.city|default('') ~ ' ' ~ shipping.postal_code|default(''),
                  region_label,
                  shipping.phone|default('') ~ ' · ' ~ shipping.email|default(''),
                ] %}
                <p class="mt-1 text-small whitespace-pre-line text-ink-2">{{ ship_lines|join("\n") }}</p>
              </div>
              <a href="/checkout" aria-label="Edit ship to" class="btn btn--tertiary btn--sm">
                {{ icons.icon('edit', 18) }}
                <span>Edit</span>
              </a>
            </div>
            <div class="flex items-start justify-between gap-4 p-4">
              <div>
                <p class="text-small font-semibold">Payment</p>
                <p class="mt-1 text-small whitespace-pre-line text-ink-2">Simulated {{ payment.brand|default('card') }} card ending {{ payment.last4|default('') }}</p>
              </div>
              <a href="/checkout/payment" aria-label="Edit payment" class="btn btn--tertiary btn--sm">
                {{ icons.icon('edit', 18) }}
                <span>Edit</span>
              </a>
            </div>
            <div class="flex items-start justify-between gap-4 p-4">
              <div>
                <p class="text-small font-semibold">Delivery</p>
                <p class="mt-1 text-small whitespace-pre-line text-ink-2">{{ delivery_estimate }}</p>
              </div>
              <a href="/checkout" aria-label="Edit delivery" class="btn btn--tertiary btn--sm">
                {{ icons.icon('edit', 18) }}
                <span>Edit</span>
              </a>
            </div>
          </div>

          <div class="mt-5">
            <div class="flex items-center gap-3 rounded-control border-[1.5px] border-dashed border-info bg-info-bg px-4 py-3 text-info">
              {{ icons.icon('lock', 20, 'flex-none') }}
              <p class="text-small font-bold tracking-wide">SIMULATED PAYMENT &mdash; no real transaction occurs</p>
            </div>
          </div>

          <form method="post" action="/checkout/place" data-checkout-place>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="idempotency_key" value="{{ idempotency_key }}">
            <button type="submit" class="btn btn--primary btn--lg mt-6" data-checkout-submit>
              <span class="inline-flex items-center gap-2" data-checkout-submit-label>
                {{ icons.icon('lock', 20) }}
                <span>Place demo order · &#8369;{{ (total_centavos / 100)|number_format(total_cent == 0 ? 0 : 2, '.', ',') }}</span>
              </span>
            </button>
            <p class="mt-4 hidden items-center gap-3 text-small text-ink-2" role="status" data-checkout-processing>
              <span>Placing your order&hellip;</span>
            </p>
          </form>
          <p class="mt-3 text-caption text-ink-2">By placing this order you confirm you understand it is fictional.</p>
        </div>
      </div>

      {{ summary_aside(cart, 3, region_label, shipping_fee_centavos, total_centavos) }}
    </div>
  </div>
{% endblock %}

{% block scripts %}
  {{ parent() }}
  <script src="/assets/js/checkout.js" defer></script>
{% endblock %}
