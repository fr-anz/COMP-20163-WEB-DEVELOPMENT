{#-
  Habi product card, exact reference catalog card. Receives product (one
  ProductService row) and csrf_token (string) — the include sites pass both
  explicitly — plus optional eager (bool): above-the-fold listing cards load
  their image eagerly with high fetch priority (LCP, N1). Single stretched
  link on the title
  (after:absolute overlay); the add-to-bag form sits above it as an
  independent visible control (relative z-10). Price in centavos, stock chip
  per state ("Only N left" at or below the low-stock threshold, matching the
  detail page); sold-out cards show the chip and disable the action.
-#}
{% import "macros/icons.twig" as icons %}
<li class="anim-fade">
  <article class="group relative flex flex-col">
    <div class="relative aspect-[4/5] overflow-hidden rounded-panel border border-line bg-[#F3EEE4]">
      <img src="{{ product.image_path }}"
           alt="{{ product.name }}"
           class="block h-full w-full" width="480" height="600" {% if eager|default(false) %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
    </div>
    <div class="mt-3 flex flex-1 flex-col">
      <h3 class="mt-1 text-body leading-snug font-semibold">
        <a href="/product/{{ product.slug }}"
           class="text-left decoration-action decoration-2 underline-offset-4 group-hover:underline after:absolute after:inset-0 after:rounded-panel focus-visible:outline-none focus-visible:after:outline-3 focus-visible:after:outline-offset-4 focus-visible:after:outline-focus">{{ product.name }}</a>
      </h3>
      <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
        <span class="text-body font-semibold tabular-nums">
          <span class="sr-only">Price: </span>{% if product.price_centavos % 100 == 0 %}&#8369;{{ (product.price_centavos / 100)|number_format(0, '.', ',') }}{% else %}&#8369;{{ (product.price_centavos / 100)|number_format(2, '.', ',') }}{% endif %}
        </span>
        {% if product.stock == 0 %}
          <span class="chip bg-error-bg text-error">
            <span class="h-2 w-2 rotate-45 border-[1.5px] border-current" aria-hidden="true"></span>Sold out</span>
        {% elseif product.stock <= product.low_stock_threshold %}
          <span class="chip bg-warning-bg text-warning">{{ icons.icon('alert', 14) }}Only {{ product.stock }} left</span>
        {% endif %}
      </div>
      {# R7: native POST /cart/add, kept above the title's stretched-link
         overlay (relative z-10) so it stays an independent visible control. #}
      <div class="relative z-10 mt-3">
        {% if product.stock > 0 %}
          <form method="post" action="/cart/add" data-cart-add>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="product_id" value="{{ product.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="btn btn--secondary btn--sm w-full">
              {{ icons.icon('bag', 18) }}<span>Add to bag</span>
            </button>
          </form>
        {% else %}
          <button type="button" class="btn btn--secondary btn--sm w-full" disabled>
            <span>Sold out</span><span class="sr-only"> — this bag can't be added to your bag</span>
          </button>
        {% endif %}
      </div>
    </div>
  </article>
</li>
