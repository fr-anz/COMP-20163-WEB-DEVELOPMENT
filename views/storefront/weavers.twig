{#-
  Meet the Weavers (R30): active weavers in the catalog grid, each card a
  4:5 portrait, the name (stretched link to the profile), community ·
  region and fibers · techniques. Receives weavers and fiber_art.
-#}
{% extends "layouts/base.twig" %}
{% set active_nav = 'weavers' %}

{% block title %}{{ t('weavers.heading') }} — {{ app_name }}{% endblock %}

{% block description %}{{ t('weavers.description') }}{% endblock %}

{% block content %}
  <div class="mx-auto max-w-[1280px] px-4 py-8 @3xl:px-8 @3xl:py-12">
    <div class="border-b border-line pb-6">
      <h1 class="font-display text-[30px] font-bold @3xl:text-h1">{{ t('weavers.heading') }}</h1>
    </div>

    {% if weavers|length > 0 %}
      <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 @3xl:grid-cols-3 @5xl:grid-cols-4 @5xl:gap-x-6">
        {% for weaver in weavers %}
          {% set fibers = weaver.fibers|split(',')|map(f => f|trim|capitalize)|filter(f => f != '')|join(', ') %}
          {% set place = [weaver.community, weaver.region]|filter(v => v != '')|join(' · ') %}
          {% set craft = [fibers, weaver.techniques]|filter(v => v != '')|join(' · ') %}
          <li class="anim-fade">
            <article class="group relative flex flex-col">
              {% include 'storefront/_weaver-portrait.twig' with { weaver: weaver, fiber_art: fiber_art, eager: loop.index <= 4 } only %}
              <h2 class="mt-3 text-body leading-snug font-semibold">
                <a href="/weavers/{{ weaver.slug|url_encode }}"
                   class="text-left decoration-action decoration-2 underline-offset-4 group-hover:underline after:absolute after:inset-0 after:rounded-panel focus-visible:outline-none focus-visible:after:outline-3 focus-visible:after:outline-offset-4 focus-visible:after:outline-focus">{{ weaver.display_name }}</a>
              </h2>
              {% if place != '' %}<p class="mt-1 text-small text-ink-2">{{ place }}</p>{% endif %}
              {% if craft != '' %}<p class="mt-1 text-small text-ink-2">{{ craft }}</p>{% endif %}
            </article>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="mt-6 rounded-panel border border-line bg-surface p-6">
        <h2 class="font-display text-h3 font-semibold">{{ t('weavers.empty') }}</h2>
        <p class="mt-3"><a class="link touch-link" href="/products">{{ t('shell.browse_collection') }}</a></p>
      </div>
    {% endif %}
  </div>
{% endblock %}
