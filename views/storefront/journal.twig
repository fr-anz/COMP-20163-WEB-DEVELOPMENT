{#-
  Heritage Journal (R31): published articles, newest first, as cards with
  a 16:9 cover (woven band when the article has none), title (stretched
  link), excerpt and date. Receives articles.
-#}
{% extends "layouts/base.twig" %}
{% set active_nav = 'journal' %}

{% block title %}Heritage Journal — {{ app_name }}{% endblock %}

{% block description %}Short reads on the bayong, native fibers and Filipino weaving traditions.{% endblock %}

{% block content %}
  <div class="mx-auto max-w-[1280px] px-4 py-8 @3xl:px-8 @3xl:py-12">
    <div class="border-b border-line pb-6">
      <h1 class="font-display text-[30px] font-bold @3xl:text-h1">Heritage Journal</h1>
    </div>

    {% if articles|length > 0 %}
      <ul class="mt-6 grid gap-x-6 gap-y-8 @3xl:grid-cols-2 @5xl:grid-cols-3">
        {% for article in articles %}
          <li class="anim-fade">
            <article class="group relative flex flex-col">
              <div class="aspect-[16/9] overflow-hidden rounded-panel border border-line bg-[#F3EEE4]">
                <img src="{{ article.cover_path ?: '/assets/img/reference/hero-band.svg' }}" alt="" class="block h-full w-full object-cover" width="640" height="360" {% if loop.index <= 3 %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
              </div>
              <h2 class="mt-4 font-display text-h3 font-semibold">
                <a href="/journal/{{ article.slug|url_encode }}"
                   class="text-left decoration-action decoration-2 underline-offset-4 group-hover:underline after:absolute after:inset-0 after:rounded-panel focus-visible:outline-none focus-visible:after:outline-3 focus-visible:after:outline-offset-4 focus-visible:after:outline-focus">{{ article.title }}</a>
              </h2>
              {% if article.excerpt != '' %}<p class="mt-2 text-ink-2">{{ article.excerpt }}</p>{% endif %}
              {% if article.published_on %}<p class="mt-2 text-small text-ink-2"><time datetime="{{ article.published_on }}">{{ article.published_on|date('j F Y') }}</time></p>{% endif %}
            </article>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="mt-6 rounded-panel border border-line bg-surface p-6">
        <h2 class="font-display text-h3 font-semibold">No articles yet</h2>
        <p class="mt-3"><a class="link touch-link" href="/products">Browse the collection</a></p>
      </div>
    {% endif %}
  </div>
{% endblock %}
