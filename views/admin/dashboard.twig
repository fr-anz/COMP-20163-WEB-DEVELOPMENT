{#-
  Admin dashboard (R18), the published Dashboard example with live data:
  order and sales cards (Orders to confirm, Payments to verify linking to
  the filtered order list, Sales today and this month with the overall
  total; sales exclude rejected and cancelled orders), orders by status,
  four inventory metric cards, low-stock alerts (active products at or below their
  threshold, each linking to the audited adjustment dialog), products still
  owned by the placeholder weaver (SDD §15.9; only when there are any) and
  the five most recent orders. Receives: metrics (AdminProductService::metrics),
  summary (OrderService::adminSummary) plus the layout variables.
-#}
{% extends "admin/layout.twig" %}
{% import "macros/icons.twig" as icons %}
{% import "admin/_macros.twig" as ui %}
{% set active_nav = 'dashboard' %}

{% block title %}Dashboard{% endblock %}

{% block content %}
  <h1 class="text-h2 font-semibold">Dashboard</h1>
  <div class="mt-4 grid grid-cols-2 gap-3 @4xl:grid-cols-4">
    <a href="/admin/orders?status=pending" class="rounded-control border border-line bg-surface p-4 hover:bg-page">
      <p class="text-caption font-medium text-ink-2">Orders to confirm</p>
      <p class="mt-1 text-[26px] leading-none font-semibold tabular-nums">{{ summary.to_confirm }}</p>
      <p class="mt-1.5 text-caption text-ink-2">{{ summary.today }} placed today</p>
    </a>
    <a href="/admin/orders?method=transfer&amp;payment=for_verification" class="rounded-control border border-line bg-surface p-4 hover:bg-page">
      <p class="text-caption font-medium text-ink-2">Payments to verify</p>
      <p class="mt-1 text-[26px] leading-none font-semibold tabular-nums{% if summary.payments_to_verify > 0 %} text-warning{% endif %}">{{ summary.payments_to_verify }}</p>
      <p class="mt-1.5 text-caption text-ink-2">Transfers waiting for review</p>
    </a>
    <div class="rounded-control border border-line bg-surface p-4">
      <p class="text-caption font-medium text-ink-2">Sales today</p>
      <p class="mt-1 text-[26px] leading-none font-semibold tabular-nums">{{ ui.money(summary.sales_today) }}</p>
    </div>
    <div class="rounded-control border border-line bg-surface p-4">
      <p class="text-caption font-medium text-ink-2">Sales this month</p>
      <p class="mt-1 text-[26px] leading-none font-semibold tabular-nums">{{ ui.money(summary.sales_month) }}</p>
      <p class="mt-1.5 text-caption text-ink-2">{{ ui.money(summary.sales_total) }} overall</p>
    </div>
  </div>
  <section aria-labelledby="by-status-h" class="mt-3">
    <h2 id="by-status-h" class="sr-only">Orders by status</h2>
    <ul class="flex flex-wrap gap-2">
      {% for status, count in summary.by_status %}
        <li><a class="inline-flex items-center gap-2 rounded-control border border-line bg-surface px-3 py-1.5 text-small hover:bg-page" href="/admin/orders?status={{ status }}">{{ ui.status_chip(status) }}<span class="font-semibold tabular-nums">{{ count }}</span></a></li>
      {% endfor %}
    </ul>
  </section>
  <div class="mt-3 grid grid-cols-2 gap-3 @4xl:grid-cols-4">
    <div class="rounded-control border border-line bg-surface p-4">
      <p class="text-caption font-medium text-ink-2">Active products</p>
      <p class="mt-1 text-[26px] leading-none font-semibold tabular-nums">{{ metrics.active }}</p>
    </div>
    <div class="rounded-control border border-line bg-surface p-4">
      <p class="text-caption font-medium text-ink-2">Units in stock</p>
      <p class="mt-1 text-[26px] leading-none font-semibold tabular-nums">{{ metrics.units }}</p>
    </div>
    <div class="rounded-control border border-line bg-surface p-4">
      <p class="text-caption font-medium text-ink-2">Low or sold out</p>
      <p class="mt-1 text-[26px] leading-none font-semibold tabular-nums{% if metrics.low_or_out > 0 %} text-warning{% endif %}">{{ metrics.low_or_out }}</p>
      <p class="mt-1.5 text-caption text-ink-2">{% if metrics.thresholds|length == 1 %}Threshold ≤ {{ metrics.thresholds|first }}{% else %}At or below each threshold{% endif %}</p>
    </div>
    <div class="rounded-control border border-line bg-surface p-4">
      <p class="text-caption font-medium text-ink-2">Orders to fulfil</p>
      <p class="mt-1 text-[26px] leading-none font-semibold tabular-nums">{{ summary.to_fulfil }}</p>
      <p class="mt-1.5 text-caption text-ink-2">{{ summary.today }} placed today</p>
    </div>
  </div>

  <div class="mt-6 grid gap-6 @5xl:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
    <section aria-labelledby="low-stock-h">
      <h2 id="low-stock-h" class="mb-2 flex items-center gap-2 text-body font-semibold">{{ icons.icon('alert', 18) }} Low-stock alerts</h2>
      <ul class="divide-y divide-line rounded-control border border-line bg-surface">
        {% for product in metrics.low_stock %}
          <li class="flex items-center gap-3 px-3 py-2.5">
            <div class="min-w-0 flex-1">
              <p class="truncate text-small font-semibold">{{ product.name }}</p>
              {{ ui.stock_chip(product) }}
            </div>
            <a class="btn btn--secondary btn--sm" href="/admin/inventory/{{ product.id }}/adjust"><span>Adjust</span><span class="sr-only"> stock for {{ product.name }}</span></a>
          </li>
        {% else %}
          <li class="flex items-center gap-2 px-3 py-2.5 text-small text-ink-2">{{ icons.icon('check', 16) }}No active bag is at or below its low-stock threshold.</li>
        {% endfor %}
      </ul>
      {% if metrics.unassigned %}
        <h2 id="unassigned-h" class="mt-6 mb-2 flex items-center gap-2 text-body font-semibold">{{ icons.icon('alert', 18) }} Products without a weaver</h2>
        <ul class="divide-y divide-line rounded-control border border-line bg-surface" aria-labelledby="unassigned-h">
          {% for product in metrics.unassigned %}
            <li class="flex items-center gap-3 px-3 py-2.5">
              <p class="min-w-0 flex-1 truncate text-small font-semibold">{{ product.name }}</p>
              <a class="btn btn--secondary btn--sm" href="/admin/products/{{ product.id }}/edit"><span>Edit</span><span class="sr-only"> {{ product.name }}</span></a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>
    <section aria-labelledby="recent-h" class="min-w-0">
      <h2 id="recent-h" class="mb-2 text-body font-semibold">Recent orders</h2>
      <div class="relative overflow-x-auto rounded-control border border-line bg-surface">
        <table class="w-full min-w-[640px] text-left text-small">
          <caption class="sr-only">Recent orders</caption>
          <thead>
            <tr>
              {% for heading in ['Order', 'Region', 'Total', 'Status', 'Payment'] %}
                <th scope="col" class="border-b border-line bg-page px-3 py-2.5 text-caption font-semibold tracking-wide text-ink-2 uppercase">{{ heading }}</th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for order in summary.recent %}
              <tr>
                <td class="border-b border-line px-3 py-2.5 align-middle font-mono font-semibold"><a class="touch-link inline-block py-1 underline-offset-4 hover:underline" href="/admin/orders/{{ order.order_number|url_encode }}">{{ order.order_number }}</a></td>
                <td class="border-b border-line px-3 py-2.5 align-middle">{{ regions[order.shipping_region]|default(order.shipping_region) }}</td>
                <td class="border-b border-line px-3 py-2.5 align-middle tabular-nums">{{ ui.money(order.total_centavos) }}</td>
                <td class="border-b border-line px-3 py-2.5 align-middle">{{ ui.status_chip(order.status) }}</td>
                <td class="border-b border-line px-3 py-2.5 align-middle">{{ ui.payment_chip(order.payment_status) }}</td>
              </tr>
            {% else %}
              <tr><td colspan="5" class="px-3 py-2.5 text-ink-2">No orders yet. Orders appear here once customers check out.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </div>
{% endblock %}
