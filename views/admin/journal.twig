{#-
  Admin Journal (R31, R43): articles (drafts first) with status chip,
  publication date, Edit and Publish/Unpublish. Receives: articles.
-#}
{% extends "admin/layout.twig" %}
{% import "macros/icons.twig" as icons %}
{% import "admin/_macros.twig" as ui %}
{% set active_nav = 'journal' %}

{% block title %}Journal{% endblock %}

{% block content %}
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <h1 class="text-h2 font-semibold">Journal</h1>
    <a class="btn btn--primary btn--sm" href="/admin/journal/new">{{ icons.icon('plus', 18) }}<span>Add article</span></a>
  </div>
  <div class="relative overflow-x-auto rounded-control border border-line bg-surface">
    <table class="w-full min-w-[640px] text-left text-small">
      <caption class="sr-only">Journal articles</caption>
      <thead>
        <tr>
          {% for heading in ['Article', 'Status', 'Published', 'Updated'] %}
            <th scope="col" class="border-b border-line bg-page px-3 py-2.5 text-caption font-semibold tracking-wide text-ink-2 uppercase">{{ heading }}</th>
          {% endfor %}
          <th scope="col" class="border-b border-line bg-page px-3 py-2.5 text-right"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        {% for article in articles %}
          <tr class="hover:bg-page">
            <td class="border-b border-line px-3 py-2.5 align-middle"><span class="font-semibold">{{ article.title }}</span><span class="block text-caption text-ink-2">/journal/{{ article.slug }}</span></td>
            <td class="border-b border-line px-3 py-2.5 align-middle">
              {% if article.status == 'published' %}<span class="chip bg-success-bg text-success">{{ icons.icon('check', 14) }}Published</span>{% else %}<span class="chip bg-inset text-ink-2">{{ icons.icon('edit', 14) }}Draft</span>{% endif %}
            </td>
            <td class="border-b border-line px-3 py-2.5 align-middle tabular-nums">{{ article.published_at ? article.published_at|slice(0, 10) : '—' }}</td>
            <td class="border-b border-line px-3 py-2.5 align-middle tabular-nums">{{ article.updated_at|slice(0, 10) }}</td>
            <td class="border-b border-line px-3 py-2.5 align-middle text-right">
              <div class="flex flex-wrap items-center justify-end gap-1">
                <a href="/admin/journal/{{ article.id }}/edit" aria-label="Edit {{ article.title }}" title="Edit {{ article.title }}" class="icon-btn relative">{{ icons.icon('edit') }}</a>
                <form method="post" action="/admin/journal/{{ article.id }}/{{ article.status == 'published' ? 'unpublish' : 'publish' }}">
                  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                  <button type="submit" class="btn {{ article.status == 'published' ? 'btn--tertiary' : 'btn--secondary' }} btn--sm">{{ article.status == 'published' ? 'Unpublish' : 'Publish' }}<span class="sr-only"> {{ article.title }}</span></button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="px-3 py-2.5 text-ink-2">No articles yet. <a class="link" href="/admin/journal/new">Write the first article</a></td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
