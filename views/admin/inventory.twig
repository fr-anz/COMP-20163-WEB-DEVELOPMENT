{#-
  Admin Inventory (R21, R18): the published Inventory table (on-hand count
  with stock bar, status chip, Adjust stock) and its two-step adjustment
  dialogs. dialog.type 'adjust' is a GET form (change, reason, optional
  note) to …/review; 'review' shows Current → New and POSTs the change with
  the reviewed stock as expected_stock, so a concurrent change forces a
  fresh review instead of being overwritten. Every applied change writes a
  stock_audit row.
  Receives: products, q, stock, list_query, dialog, reasons.
-#}
{% extends "admin/layout.twig" %}
{% import "macros/icons.twig" as icons %}
{% import "admin/_macros.twig" as ui %}
{% set active_nav = 'inventory' %}
{% set dialog_open = dialog is not null %}

{% block title %}Inventory{% endblock %}

{% block content %}
  <h1 class="mb-4 text-h2 font-semibold">Inventory</h1>
  {% include 'admin/_filters.twig' with {action: '/admin/inventory', q: q, stock: stock, count: products|length} only %}
  <div class="relative overflow-x-auto rounded-control border border-line bg-surface">
    <table class="w-full min-w-[640px] text-left text-small">
      <caption class="sr-only">Inventory</caption>
      <thead>
        <tr>
          {% for heading in ['Product', 'On hand', 'Status'] %}
            <th scope="col" class="border-b border-line bg-page px-3 py-2.5 text-caption font-semibold tracking-wide text-ink-2 uppercase">{{ heading }}</th>
          {% endfor %}
          <th scope="col" class="border-b border-line bg-page px-3 py-2.5 text-caption font-semibold tracking-wide text-ink-2 uppercase text-right"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        {% for product in products %}
          <tr class="hover:bg-page">
            <td class="border-b border-line px-3 py-2.5 align-middle font-semibold">{{ product.name }}</td>
            <td class="border-b border-line px-3 py-2.5 align-middle">
              <div class="flex items-center gap-2">
                <span class="w-6 text-right text-small font-semibold tabular-nums">{{ product.stock }}</span>
                <span class="relative h-1.5 w-16 overflow-hidden rounded-sm bg-inset" aria-hidden="true">
                  {% if product.stock > 0 %}
                    <span class="absolute inset-y-0 left-0 {{ product.stock <= product.low_stock_threshold ? 'bg-warning' : 'bg-success' }}" style="width: {{ min(100, product.stock * 5) }}%;"></span>
                  {% endif %}
                </span>
              </div>
            </td>
            <td class="border-b border-line px-3 py-2.5 align-middle">{{ ui.stock_chip(product) }}</td>
            <td class="border-b border-line px-3 py-2.5 align-middle text-right">
              <a class="btn btn--secondary btn--sm" href="/admin/inventory/{{ product.id }}/adjust{{ list_query }}"><span>Adjust stock</span><span class="sr-only"> for {{ product.name }}</span></a>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="4" class="px-3 py-2.5 text-ink-2">No products match these filters. <a class="link" href="/admin/inventory">Show all products</a></td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}

{% block dialog %}
  {% if dialog and dialog.type == 'adjust' %}
    {% set product = dialog.product %}
    {% set v = dialog.values %}
    {% set e = dialog.errors %}
    {% embed 'admin/_dialog.twig' with {
      dialog_id: 'adjust-dialog',
      title: 'Adjust stock',
      description: product.name,
      close_href: '/admin/inventory' ~ list_query,
      form_action: '/admin/inventory/' ~ product.id ~ '/review',
      form_method: 'get',
    } %}
      {% import "admin/_macros.twig" as ui %}
      {% block body %}
        {% if q %}<input type="hidden" name="q" value="{{ q }}">{% endif %}
        {% if stock != 'all' %}<input type="hidden" name="stock" value="{{ stock }}">{% endif %}
        <div class="grid gap-4">
          <p class="text-small">Current stock: <strong class="tabular-nums">{{ product.stock }}</strong></p>
          {{ ui.input('change', 'Change', v.change, e, {required: true, type: 'number', min: -9999, max: 9999, inputmode: 'numeric', hint: 'Use a negative number to remove units.'}) }}
          {{ ui.select('reason', 'Reason', v.reason, reasons|reduce((carry, r) => carry|merge({(r): r}), {}), e, {required: true, placeholder: 'Choose a reason'}) }}
          {{ ui.input('note', 'Note', v.note, e, {textarea: true, rows: 2, optional: true, maxlength: 200}) }}
        </div>
      {% endblock %}
      {% block footer %}
        <a class="btn btn--secondary" href="{{ close_href }}"><span>Cancel</span></a>
        <button type="submit" class="btn btn--primary"><span>Review change</span></button>
      {% endblock %}
    {% endembed %}
  {% elseif dialog and dialog.type == 'review' %}
    {% set p = dialog.preview %}
    {% set back = '/admin/inventory/' ~ dialog.product.id ~ '/adjust?' ~ ({change: dialog.values.change, reason: dialog.values.reason, note: dialog.values.note}|merge(q ? {q: q} : {})|merge(stock != 'all' ? {stock: stock} : {}))|url_encode %}
    {% embed 'admin/_dialog.twig' with {
      dialog_id: 'review-dialog',
      title: 'Confirm stock change',
      description: dialog.product.name,
      close_href: '/admin/inventory' ~ list_query,
      form_action: '/admin/products/' ~ dialog.product.id ~ '/stock' ~ list_query,
    } %}
      {% import "macros/icons.twig" as icons %}
      {% block body %}
        <input type="hidden" name="expected_stock" value="{{ p.old_stock }}">
        <input type="hidden" name="change" value="{{ p.change }}">
        <input type="hidden" name="reason" value="{{ p.reason }}">
        <input type="hidden" name="note" value="{{ p.note }}">
        <div class="flex items-center justify-center gap-4 rounded-control bg-page py-5 text-center tabular-nums">
          <div>
            <p class="text-caption text-ink-2">Current</p>
            <p class="text-h2 font-semibold">{{ p.old_stock }}</p>
          </div>
          {{ icons.icon('arrow-right', 20, 'text-ink-2') }}
          <div>
            <p class="text-caption text-ink-2">New</p>
            <p class="text-h2 font-semibold">{{ p.new_stock }}</p>
          </div>
        </div>
        <p class="sr-only">Stock will change by {{ p.change > 0 ? '+' : '' }}{{ p.change }}.</p>
        <p class="mt-3 text-small">Reason: <strong>{{ p.reason }}</strong></p>
        {% if p.note %}<p class="mt-1 text-small">Note: {{ p.note }}</p>{% endif %}
      {% endblock %}
      {% block footer %}
        <a class="btn btn--secondary" href="{{ back }}"><span>Back</span></a>
        <button type="submit" class="btn btn--primary"><span>Confirm change</span></button>
      {% endblock %}
    {% endembed %}
  {% endif %}
{% endblock %}
