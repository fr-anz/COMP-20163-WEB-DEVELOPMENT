{#-
  Admin Products (R20, R23): published Products table (thumbnail, name,
  category, price, stock chip, Edit icon) with filters, plus Add product.
  Dialogs are server-rendered: dialog.type 'product' (create when
  dialog.product is null, else edit) or 'archive'. The product form is the
  published Edit product dialog extended with every R20 field: SKU,
  demonstration material/place-of-make labels, dimensions, threshold, the
  procedural 3D config and validated image upload or a seeded demo
  illustration. Stock is set only on create; later changes go through
  Inventory so they are audited.
  Receives: products, q, stock, list_query, dialog, options, errors.
-#}
{% extends "admin/layout.twig" %}
{% import "macros/icons.twig" as icons %}
{% import "admin/_macros.twig" as ui %}
{% set active_nav = 'products' %}
{% set dialog_open = dialog is not null %}

{% block title %}Products{% endblock %}

{% block content %}
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <h1 class="text-h2 font-semibold">Products</h1>
    <a class="btn btn--primary btn--sm" href="/admin/products/new{{ list_query }}">{{ icons.icon('plus', 18) }}<span>Add product</span></a>
  </div>
  {% include 'admin/_filters.twig' with {action: '/admin/products', q: q, stock: stock, count: products|length} only %}
  <div class="relative overflow-x-auto rounded-control border border-line bg-surface">
    <table class="w-full min-w-[640px] text-left text-small">
      <caption class="sr-only">Products</caption>
      <thead>
        <tr>
          {% for heading in ['Product', 'Category', 'Price', 'Status'] %}
            <th scope="col" class="border-b border-line bg-page px-3 py-2.5 text-caption font-semibold tracking-wide text-ink-2 uppercase">{{ heading }}</th>
          {% endfor %}
          <th scope="col" class="border-b border-line bg-page px-3 py-2.5 text-caption font-semibold tracking-wide text-ink-2 uppercase text-right"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        {% for product in products %}
          <tr class="hover:bg-page">
            <td class="border-b border-line px-3 py-2.5 align-middle">
              <div class="flex items-center gap-3">
                <div class="h-12 w-10 flex-none overflow-hidden rounded-sm border border-line bg-[#F3EEE4]">
                  {% if product.image_path %}<img src="{{ product.image_path }}" alt="" width="40" height="48" loading="lazy" class="block h-full w-full object-contain">{% endif %}
                </div>
                <span class="font-semibold">{{ product.name }}<span class="block text-caption font-normal text-ink-2">{{ product.sku }}</span></span>
              </div>
            </td>
            <td class="border-b border-line px-3 py-2.5 align-middle">{{ product.category }}</td>
            <td class="border-b border-line px-3 py-2.5 align-middle tabular-nums">{{ ui.money(product.price_centavos) }}</td>
            <td class="border-b border-line px-3 py-2.5 align-middle">{{ ui.stock_chip(product) }}</td>
            <td class="border-b border-line px-3 py-2.5 align-middle text-right">
              <a href="/admin/products/{{ product.id }}/edit{{ list_query }}" aria-label="Edit {{ product.name }}" title="Edit {{ product.name }}" class="icon-btn relative">{{ icons.icon('edit') }}</a>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="px-3 py-2.5 text-ink-2">No products match these filters. <a class="link" href="/admin/products">Show all products</a></td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}

{% block dialog %}
  {% if dialog and dialog.type == 'product' %}
    {% set product = dialog.product %}
    {% set v = dialog.values %}
    {% set e = dialog.errors %}
    {% set close = '/admin/products' ~ list_query %}
    {% embed 'admin/_dialog.twig' with {
      dialog_id: 'product-dialog',
      title: product ? 'Edit product' : 'Add product',
      description: product ? product.name ~ ' · ' ~ product.sku : 'Fictional demo bag · every field is a demonstration label',
      close_href: close,
      max_width: '520px',
      form_action: (product ? '/admin/products/' ~ product.id : '/admin/products') ~ list_query,
      form_enctype: 'multipart/form-data',
    } %}
      {% import "macros/icons.twig" as icons %}
      {% import "admin/_macros.twig" as ui %}
      {% block body %}
        {% if e|length %}
          <div class="mb-4 flex gap-3 rounded-control border px-4 py-3 bg-error-bg text-error border-error/30" role="alert" data-error-summary>
            {{ icons.icon('alert', 20, 'mt-0.5 flex-none') }}
            <div class="min-w-0 flex-1">
              <p class="text-[15px] font-semibold">Check the highlighted fields</p>
              <ul class="mt-1 space-y-1 text-small">
                {% for field, message in e %}
                  <li><a href="#f-{{ field|replace({'_': '-'}) }}" class="underline underline-offset-2">{{ message }}</a></li>
                {% endfor %}
              </ul>
            </div>
          </div>
        {% endif %}
        <div class="grid gap-4">
          {{ ui.input('name', 'Product name', v.name, e, {required: true, maxlength: 80}) }}
          <div class="grid grid-cols-2 gap-4">
            {{ ui.input('sku', 'SKU', v.sku, e, {required: true, maxlength: 32, autocomplete: 'off', input_class: 'uppercase'}) }}
            {{ ui.select('category', 'Category', v.category, options.categories|reduce((carry, c) => carry|merge({(c): c}), {}), e) }}
          </div>
          <div class="grid grid-cols-2 gap-4">
            {{ ui.input('price', 'Price (PHP)', v.price, e, {required: true, inputmode: 'decimal', placeholder: '1650.00'}) }}
            {% if product %}
              <div>
                <p class="field-label">Stock</p>
                <p class="flex min-h-11 items-center gap-2 text-small"><strong class="tabular-nums">{{ product.stock }}</strong><a class="link" href="/admin/inventory/{{ product.id }}/adjust">Adjust in Inventory</a></p>
              </div>
            {% else %}
              {{ ui.input('stock', 'Starting stock', v.stock, e, {required: true, type: 'number', min: 0, max: 9999, inputmode: 'numeric'}) }}
            {% endif %}
          </div>
          {{ ui.input('low_stock_threshold', 'Low-stock threshold', v.low_stock_threshold, e, {required: true, type: 'number', min: 0, max: 99, inputmode: 'numeric', hint: 'Shows “Only N left” and a dashboard alert at or below this.'}) }}
          {{ ui.input('description', 'Description', v.description, e, {textarea: true, rows: 3, maxlength: 2000}) }}
          {{ ui.input('materials', 'Materials label', v.materials, e, {required: true, maxlength: 200, hint: 'Demonstration label — not a factual material claim.'}) }}
          {{ ui.input('place_of_make', 'Place-of-make label', v.place_of_make, e, {required: true, maxlength: 200, hint: 'Keep it illustrative, e.g. “origin unverified”.'}) }}
          <fieldset>
            <legend class="field-label">Dimensions (cm)</legend>
            <div class="grid grid-cols-3 gap-3">
              {{ ui.input('width', 'Width', v.width, e, {required: true, type: 'number', min: 1, max: 200, inputmode: 'numeric'}) }}
              {{ ui.input('height', 'Height', v.height, e, {required: true, type: 'number', min: 1, max: 200, inputmode: 'numeric'}) }}
              {{ ui.input('depth', 'Depth', v.depth, e, {required: true, type: 'number', min: 1, max: 200, inputmode: 'numeric'}) }}
            </div>
          </fieldset>
          <fieldset class="grid gap-4 rounded-control border border-line p-3">
            <legend class="px-1 text-small font-semibold">3D model</legend>
            <div class="grid grid-cols-2 gap-4">
              {{ ui.select('shape', 'Shape', v.shape, options.shapes, e) }}
              {{ ui.select('handle_style', 'Handles', v.handle_style, options.handle_styles, e) }}
              {{ ui.select('material', 'Surface', v.material, options.materials, e) }}
              {{ ui.select('lining', 'Lining', v.lining, options.linings, e) }}
            </div>
            <div class="grid grid-cols-3 gap-3">
              {{ ui.input('color_body', 'Body', v.color_body, e, {type: 'color', input_class: 'h-11 p-1'}) }}
              {{ ui.input('color_trim', 'Trim', v.color_trim, e, {type: 'color', input_class: 'h-11 p-1'}) }}
              {{ ui.input('color_lining', 'Lining', v.color_lining, e, {type: 'color', input_class: 'h-11 p-1'}) }}
            </div>
            <fieldset{% if e.pockets is defined %} aria-describedby="f-pockets-err"{% endif %}>
              <legend id="f-pockets" class="field-label" tabindex="-1">Pockets</legend>
              <div class="grid gap-x-3 @2xl:grid-cols-2">
                {% for key, label in options.pockets %}
                  <label class="flex min-h-11 cursor-pointer items-center gap-2.5 text-small">
                    <input class="check" type="checkbox" name="pockets[]" value="{{ key }}"{% if key in v.pockets %} checked{% endif %}>{{ label }}
                  </label>
                {% endfor %}
              </div>
              {{ ui.field_error('f-pockets', e.pockets|default(null)) }}
            </fieldset>
          </fieldset>
          <div>
            <p class="field-label" id="f-image">Images</p>
            <div class="flex flex-wrap items-center gap-3 rounded-control border-[1.5px] border-dashed border-line-strong bg-page p-3">
              <div class="h-16 w-[52px] flex-none overflow-hidden rounded-sm border border-line bg-[#F3EEE4]">
                {% set current = product ? (product.images|first).path|default(null) : null %}
                {% if current %}<img src="{{ current }}" alt="Current main image" width="52" height="64" class="block h-full w-full object-contain">{% endif %}
              </div>
              <label class="btn btn--secondary btn--sm">
                {{ icons.icon('upload', 18) }}<span>Upload image</span>
                <input type="file" name="image" accept="image/jpeg,image/png,image/webp" class="sr-only" data-file-input
                       aria-describedby="f-image-hint{% if e.image is defined %} f-image-err{% endif %}"{% if e.image is defined %} aria-invalid="true"{% endif %}>
              </label>
              <span id="f-image-hint" class="text-caption text-ink-2" data-file-name>JPG, PNG or WebP · up to 2 MB · 4:5, neutral background</span>
            </div>
            {{ ui.field_error('f-image', e.image|default(null)) }}
            {% set demo_options = {} %}
            {% for path in options.demo_images %}{% set demo_options = demo_options|merge({(path): path|split('/')|last|replace({'.svg': '', '-': ' '})|title ~ ' illustration'}) %}{% endfor %}
            {{ ui.select('demo_image', product ? 'Or switch to a demo illustration' : 'Or use a demo illustration', v.demo_image, demo_options, e, {placeholder: product ? 'Keep the current image' : 'Choose an illustration', class: 'mt-3'}) }}
          </div>
          <p class="text-caption text-ink-2">{% if product %}Stock is changed from Inventory so every change is audited.{% else %}Starting stock is recorded in the stock audit; later changes happen in Inventory.{% endif %}</p>
        </div>
      {% endblock %}
      {% block footer %}
        {% if product and product.is_active %}
          <a class="btn btn--destructive mr-auto" href="/admin/products/{{ product.id }}/archive{{ list_query }}">Archive…</a>
        {% elseif product %}
          <button type="submit" form="restore-form" class="btn btn--secondary mr-auto">Restore to storefront</button>
        {% endif %}
        <a class="btn btn--secondary" href="{{ close_href }}"><span>Cancel</span></a>
        <button type="submit" class="btn btn--primary"><span>{{ product ? 'Save product' : 'Add product' }}</span></button>
      {% endblock %}
    {% endembed %}
    {% if product and not product.is_active %}
      <form id="restore-form" method="post" action="/admin/products/{{ product.id }}/restore{{ list_query }}" hidden>
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      </form>
    {% endif %}
  {% elseif dialog and dialog.type == 'archive' %}
    {% embed 'admin/_dialog.twig' with {
      dialog_id: 'archive-dialog',
      title: 'Archive ' ~ dialog.product.name ~ '?',
      description: 'It will be hidden from the storefront. Order history is kept.',
      close_href: '/admin/products' ~ list_query,
      form_action: '/admin/products/' ~ dialog.product.id ~ '/archive' ~ list_query,
    } %}
      {% block footer %}
        <a class="btn btn--secondary" href="{{ close_href }}"><span>Cancel</span></a>
        <button type="submit" class="btn btn--destructive"><span>Archive product</span></button>
      {% endblock %}
    {% endembed %}
  {% endif %}
{% endblock %}
