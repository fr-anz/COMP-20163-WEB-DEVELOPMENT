{
    "name": "habi/storefront",
    "description": "Habi: educational Filipino-inspired handbag storefront (fictional demo). M0 foundation.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "slim/slim": "^4.14",
        "twig/twig": "^3.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Habi\\": "src/"
        },
        "files": [
            "src/Support/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Habi\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "cs": "phpcs --standard=PSR12 src public/index.php seed tests",
        "lint": "find src public seed tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit"
    }
}
